# Docker Environment Configuration
# Copy this file to docker.env and update values for your environment

# Application Environment
APP_ENV=development
NGINX_PORT=8081

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_DATABASE=omnes_db
DB_USERNAME=omnes_user
DB_PASSWORD=omnes_password
DB_ROOT_PASSWORD=root_password

# Frontend Configuration
VITE_API_URL=http://localhost:8081/api/v1

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# Application Configuration
APP_URL=http://localhost:8081
APP_NAME=Omnes Marketplace

# Security Configuration
CSRF_ENABLED=true
HTTPS_ENABLED=false
RATE_LIMIT_ENABLED=true

# Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_MIMES=image/jpeg,image/jpg,image/png,image/webp
