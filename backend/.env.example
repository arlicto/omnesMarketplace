# =============================================================================
# Omnes Marketplace API — environment template (SAFE TO COMMIT)
# =============================================================================
#
# SECURITY:
#   - NEVER commit backend/.env (it is gitignored)
#   - NEVER put secrets in config/env/ profile files
#   - Use long, cryptographically random secrets (see generate commands below)
#
# SETUP:
#   cp .env.example .env
#   php bin/generate-secrets.php >> .env
#   # Or paste the generated values into .env manually
#
# SECRET REQUIREMENTS (enforced at startup):
#   dev:        JWT_SECRET >= 32 chars, DB_PASSWORD >= 16 chars
#   staging:    JWT_SECRET >= 48 chars, DB_PASSWORD >= 24 chars
#   production: JWT_SECRET >= 64 chars, DB_PASSWORD >= 32 chars
#   All secrets must use multiple character classes; weak placeholders are rejected.
#
# GENERATE SECURE SECRETS (pick one):
#   php bin/generate-secrets.php
#   openssl rand -base64 48
#   php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
# =============================================================================

# Profile selector (loads config/env/.env.{profile})
APP_ENV=dev

# --- Secrets (required — leave empty until generated) ------------------------
DB_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=

# =============================================================================
# Non-secret settings are provided by config/env/.env.{profile}.
# Override below only when needed for your machine.
# =============================================================================
# APP_DEBUG=true
# DB_HOST=db
# API_BASE_URL=http://localhost:8081/api/v1

# 1779720035216088388
