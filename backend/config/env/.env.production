# Production profile — non-secret defaults (committed).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
API_BASE_URL=https://api.example.com/api/v1

DB_HOST=production-db.internal
DB_PORT=3306
DB_NAME=omnes_db
DB_USER=omnes_app
DB_CHARSET=utf8mb4

JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ALGORITHM=HS256

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
AUTH_THROTTLE_WINDOW_MINUTES=15
AUTH_EMAIL_VERIFY_TTL_HOURS=48
AUTH_PASSWORD_RESET_TTL_HOURS=1
AUTH_TOKEN_PEPPER=
CSRF_ENABLED=true

UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_FILES=3
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SESSION_NAME=omnes_session
COOKIE_SESSION_LIFETIME=3600

LOG_LEVEL=warning
LOG_PATH=storage/logs/app.log

CORS_ALLOWED_ORIGINS=https://www.example.com
