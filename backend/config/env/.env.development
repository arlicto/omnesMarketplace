# Development profile — non-secret defaults (committed).

APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=UTC
API_BASE_URL=http://localhost:8081/api/v1

DB_HOST=db
DB_PORT=3306
DB_NAME=omnes_db
DB_USER=omnes_user
DB_CHARSET=utf8mb4

JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ALGORITHM=HS256

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_THROTTLE_WINDOW_MINUTES=15
AUTH_EMAIL_VERIFY_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_HOURS=1
AUTH_TOKEN_PEPPER=
CSRF_ENABLED=true

UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SESSION_NAME=omnes_session
COOKIE_SESSION_LIFETIME=0

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
